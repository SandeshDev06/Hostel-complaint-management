VITE_API_URL=http://localhost:5000/api
VITE_USE_MOCK=true

# ---- Google Login ----
# Create an OAuth 2.0 "Web" client at https://console.cloud.google.com/apis/credentials
# add http://localhost:5173 to "Authorized JavaScript origins", then paste the client id here.
# Leave empty to use the built-in demo account chooser.
VITE_GOOGLE_CLIENT_ID=
# Comma separated Google emails that should become Admin/Warden
VITE_ADMIN_EMAILS=
